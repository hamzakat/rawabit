RAWABIT_INGEST_POLL_SECONDS=2
RAWABIT_INGEST_TIMEOUT_SECONDS=300
RAWABIT_INGEST_PARSE_TIMEOUT_SECONDS=900
RAWABIT_ENABLE_INGESTION=true
RAWABIT_INGEST_PROFILE_DEFAULT=balanced_fast
RAWABIT_RAG_LLM_TIMEOUT_SECONDS=1000


# LLM Provider
RAWABIT_LLM_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#RAWABIT_LLM_PROVIDER_API_KEY=
RAWABIT_LLM_PROVIDER_SITE_URL=http://localhost:5173
RAWABIT_LLM_PROVIDER_APP_NAME=Rawabit GraphRAG
#RAWABIT_RAG_LLM_MODEL=openai/gpt-5.4-mini
RAWABIT_RAG_LLM_MODEL=google/gemma-4-31b-it:free
RAWABIT_RAG_VLM_MODEL=google/gemma-4-31b-it:free
RAWABIT_RAG_LLM_MAX_ASYNC=1

# Embedding Provider (leave unset to use same provider as LLM)
RAWABIT_EMBEDDING_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#RAWABIT_EMBEDDING_PROVIDER_API_KEY=
RAWABIT_RAG_EMBEDDING_MODEL=baai/bge-m3
RAWABIT_RAG_EMBEDDING_DIM_HINT=1024
RAWABIT_RAG_EMBEDDING_MAX_ASYNC=8
RAWABIT_RAG_MAX_PARALLEL_INSERT=1
RAWABIT_RAG_MAX_PARALLEL_INSERT_BALANCED=2
RAWABIT_RAG_MAX_PARALLEL_INSERT_FULL=2

RAWABIT_RAG_PARSER=mineru
RAWABIT_RAG_PARSE_METHOD=auto
RAWABIT_RAG_PARSER_DEVICE=cpu
RAWABIT_RAG_PARSER_BACKEND=pipeline
RAWABIT_PDF_PROBE_MIN_CHARS_PER_PAGE=180
RAWABIT_RAG_ENABLE_TABLE_BALANCED_MAX_PAGES=12
RAWABIT_RAG_ENABLE_FORMULA_BALANCED=false
RAWABIT_IMAGE_VLM_MIN_OCR_CHARS=120
RAWABIT_RAG_ENABLE_VLM=true
RAWABIT_RAG_ENABLE_VLM_IMAGE_ANALYSIS=true
RAWABIT_RAG_ENABLE_VLM_VISIBLE_TEXT_EXTRACTION=true
RAWABIT_RAG_ENABLE_PREINSERT_SUMMARY=true
RAWABIT_RAG_PREINSERT_SUMMARY_MAX_INPUT_CHARS=24000
RAWABIT_RAG_PREINSERT_SUMMARY_MAX_TOKENS=400
RAWABIT_RAG_BALANCED_FORCE_VLM_IMAGE_CAPTION=true
RAWABIT_RAG_VLM_PARALLEL_CAPTIONS_BALANCED=6
RAWABIT_RAG_VLM_PARALLEL_CAPTIONS_FULL=4
RAWABIT_RAG_ENABLE_IMAGE_PROCESSING=true
RAWABIT_RAG_ENABLE_TABLE_PROCESSING=true
RAWABIT_RAG_ENABLE_EQUATION_PROCESSING=false
RAWABIT_RAG_COSINE_THRESHOLD=0.55
RAWABIT_RAG_NAIVE_COSINE_THRESHOLD=0.45
RAWABIT_RAG_LLM_MAX_TOKENS=4096
RAWABIT_RAG_EVIDENCE_NORMALIZATION_MAX_TOKENS=2048
RAWABIT_RAG_TOP_K=10
RAWABIT_RAG_CHUNK_TOP_K=10

RAWABIT_RERANK_PROVIDER_BASE_URL=https://openrouter.ai/api/v1/rerank
#RAWABIT_RERANK_PROVIDER_API_KEY=
RAWABIT_RAG_RERANK_MODEL=cohere/rerank-4-fast
RAWABIT_RAG_RERANK_ENABLED=true

# Chunking
RAWABIT_RAG_CHUNK_TOKEN_SIZE=500
RAWABIT_RAG_CHUNK_OVERLAP_TOKEN_SIZE=50

# Entity resolution
RAWABIT_RAG_RESOLUTION_SIMILARITY_THRESHOLD=0.6
RAWABIT_RAG_RESOLUTION_MIN_REFERENCE_RATIO=0.03
RAWABIT_RAG_RESOLUTION_AUTO_TRIGGER=true
RAWABIT_RAG_RESOLUTION_ENABLE_INCREMENTAL=true


# Eval
EVALUATOR_TIMEOUT=300
EVALUATOR_MAX_TOKENS=8192
